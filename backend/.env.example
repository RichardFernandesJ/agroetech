# Copie para .env e ajuste os valores.
AGRO_ENVIRONMENT=development
AGRO_DEBUG=false

# PostgreSQL via Docker Compose
AGRO_DATABASE_URL=postgresql+asyncpg://agro:agro@db:5432/agroetech

# Troque por um segredo forte em produção.
AGRO_JWT_SECRET=dev-secret-change-me-in-production
AGRO_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# O schema é criado/atualizado pelo Alembic (`alembic upgrade head`).
# Mantenha false; true só é útil para um banco descartável de prototipagem.
AGRO_AUTO_CREATE_TABLES=false

# Produção offline
AGRO_OFFLINE_MAX_HOURS=12
AGRO_OFFLINE_MAX_CYCLES_PER_PLANTING=8
AGRO_MAX_PLOTS_PER_PROPERTY=12
