# Configuração usada pelo docker compose.
# Copie para .env e ajuste os valores.

POSTGRES_USER=agro
POSTGRES_PASSWORD=agro
POSTGRES_DB=agroetech
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173

# Troque por um segredo forte em produção.
AGRO_JWT_SECRET=dev-secret-change-me-in-production
AGRO_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AGRO_AUTO_CREATE_TABLES=false
AGRO_OFFLINE_MAX_HOURS=12
AGRO_OFFLINE_MAX_CYCLES_PER_PLANTING=8
